# Copy this file to .env and fill in your own values. Never commit .env.

# Base URL of the private LiteLLM endpoint (e.g. https://litellm.internal.example.com).
LITELLM_BASE_URL=

# API key accepted by the LiteLLM endpoint.
LITELLM_API_KEY=

# Model alias registered on the LiteLLM endpoint (not an Anthropic/OpenAI model id).
LITELLM_MODEL=
