# Copy this file to .env and fill in your own values. Never commit .env.

# Base URL of the private Anthropic-compatible endpoint (e.g. a LiteLLM gateway exposing
# the native Anthropic Messages API route).
ANTHROPIC_BASE_URL=

# Bearer token accepted by the endpoint (sent as `Authorization: Bearer <token>`, not as
# the `x-api-key` header ANTHROPIC_API_KEY would use).
ANTHROPIC_AUTH_TOKEN=

# Fallback model id, used whenever a tier-specific var below isn't set.
ANTHROPIC_MODEL=

# Per-tier model ids registered on the endpoint. Each crew picks one tier:
#   skill-listing        -> ANTHROPIC_SMALL_FAST_MODEL
#   interview-questions   -> ANTHROPIC_DEFAULT_HAIKU_MODEL
#   resume-assessment     -> ANTHROPIC_DEFAULT_SONNET_MODEL
#   interview-summary     -> ANTHROPIC_DEFAULT_SONNET_MODEL
#   compare               -> ANTHROPIC_DEFAULT_OPUS_MODEL
ANTHROPIC_SMALL_FAST_MODEL=
ANTHROPIC_DEFAULT_HAIKU_MODEL=
ANTHROPIC_DEFAULT_SONNET_MODEL=
ANTHROPIC_DEFAULT_OPUS_MODEL=
