# Copy this file to .env and fill in your own values. Never commit .env.

# Anthropic API key used by the CrewAI agents.
ANTHROPIC_API_KEY=

# Model string passed to CrewAI's LLM (litellm format: "anthropic/<model-id>").
# Adjust to whichever Claude model your API key has access to.
ANTHROPIC_MODEL=anthropic/claude-sonnet-4-5-20250929
