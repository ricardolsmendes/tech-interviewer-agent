<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Interview Questions — {{ questions.candidate_name }} / {{ questions.role }}</title>
  <style>
    body { font-family: Georgia, serif; max-width: 820px; margin: 40px auto; padding: 0 24px; color: #222; line-height: 1.7; }
    h1 { font-size: 1.6rem; margin-bottom: 4px; }
    .meta { color: #666; font-size: 0.9rem; margin-bottom: 32px; }
    h2 { font-size: 1.15rem; border-bottom: 1px solid #ddd; padding-bottom: 4px; margin-top: 36px; }
    ol { padding-left: 20px; }
    li { margin-bottom: 14px; }
    .question { font-weight: bold; }
    .rationale { color: #666; font-size: 0.9rem; margin-top: 2px; }
  </style>
</head>
<body>

  <h1>Interview Questions</h1>
  <div class="meta">
    Candidate: <strong>{{ questions.candidate_name }}</strong> &nbsp;|&nbsp;
    Role: <strong>{{ questions.role }}</strong> &nbsp;|&nbsp;
    Generated: {{ today() }}
  </div>

  <h2>Technical Questions</h2>
  <ol>
    {% for item in questions.technical_questions %}
    <li>
      <div class="question">{{ item.question }}</div>
      <div class="rationale">{{ item.rationale }}</div>
    </li>
    {% endfor %}
  </ol>

  <h2>Behavioural Questions</h2>
  <ol>
    {% for item in questions.behavioural_questions %}
    <li>
      <div class="question">{{ item.question }}</div>
      <div class="rationale">{{ item.rationale }}</div>
    </li>
    {% endfor %}
  </ol>

</body>
</html>
