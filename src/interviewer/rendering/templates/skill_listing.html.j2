<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Skill Listing — {{ listing.role }}</title>
  <style>
    body { font-family: Georgia, serif; max-width: 820px; margin: 40px auto; padding: 0 24px; color: #222; line-height: 1.7; }
    h1 { font-size: 1.6rem; margin-bottom: 4px; }
    .meta { color: #666; font-size: 0.9rem; margin-bottom: 32px; }
    h2 { font-size: 1.15rem; border-bottom: 1px solid #ddd; padding-bottom: 4px; margin-top: 36px; }
    h3 { font-size: 1rem; margin-top: 20px; margin-bottom: 6px; }
    ul { margin: 6px 0; padding-left: 20px; }
    li { margin-bottom: 4px; }
  </style>
</head>
<body>

  <h1>Skill Listing</h1>
  <div class="meta">
    Role: <strong>{{ listing.role }}</strong> &nbsp;|&nbsp;
    Generated: {{ today() }}
  </div>

  <h2>Hard Skills by Stack</h2>
  {% for stack in listing.hard_skills_by_stack %}
  <h3>{{ stack.stack }}</h3>
  <ul>
    {% for skill in stack.hard_skills %}
    <li>{{ skill }}</li>
    {% endfor %}
  </ul>
  {% endfor %}

  <h2>Soft Skills</h2>
  <ul>
    {% for skill in listing.soft_skills %}
    <li>{{ skill }}</li>
    {% endfor %}
  </ul>

</body>
</html>
