<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Candidate Comparison — {{ comparison.role }}</title>
  <style>
    body { font-family: Georgia, serif; max-width: 820px; margin: 40px auto; padding: 0 24px; color: #222; line-height: 1.7; }
    h1 { font-size: 1.6rem; margin-bottom: 4px; }
    .meta { color: #666; font-size: 0.9rem; margin-bottom: 32px; }
    h2 { font-size: 1.15rem; border-bottom: 1px solid #ddd; padding-bottom: 4px; margin-top: 36px; }
    .rank { display: inline-block; min-width: 1.6rem; text-align: center; background: #f5f5f5; border: 1px solid #ddd; border-radius: 50%; font-weight: bold; margin-right: 8px; }
    .candidate { border: 1px solid #ddd; border-radius: 6px; padding: 12px 16px; margin-bottom: 16px; }
    .candidate h3 { margin: 0 0 4px 0; font-size: 1.05rem; }
    .verdict-label { color: #666; font-size: 0.9rem; margin-bottom: 8px; }
    .columns { display: flex; gap: 24px; }
    .columns > div { flex: 1; }
    .columns h4 { font-size: 0.9rem; margin: 8px 0 4px 0; }
    ul { margin: 6px 0; padding-left: 20px; }
    li { margin-bottom: 4px; }
    .section-note { background: #f9f9f9; border-left: 4px solid #ccc; padding: 10px 16px; font-size: 0.93rem; margin-top: 8px; }
  </style>
</head>
<body>

  <h1>Candidate Comparison</h1>
  <div class="meta">
    Role: <strong>{{ comparison.role }}</strong> &nbsp;|&nbsp;
    Compared: {{ today() }}
  </div>

  <h2>Ranking</h2>
  {% for candidate in comparison.ranked_candidates %}
  <div class="candidate">
    <h3><span class="rank">{{ candidate.rank }}</span>{{ candidate.candidate_name }}</h3>
    <div class="verdict-label">{{ candidate.verdict_label }}</div>
    <div class="columns">
      <div>
        <h4>Key Strengths</h4>
        <ul>
          {% for item in candidate.key_strengths %}
          <li>{{ item }}</li>
          {% endfor %}
        </ul>
      </div>
      <div>
        <h4>Key Risks</h4>
        <ul>
          {% for item in candidate.key_risks %}
          <li>{{ item }}</li>
          {% endfor %}
        </ul>
      </div>
    </div>
  </div>
  {% endfor %}

  <h2>Key Differentiators</h2>
  <p>{{ comparison.differentiators }}</p>

  <h2>Recommendation</h2>
  <div class="section-note">
    {{ comparison.recommendation }}
  </div>

</body>
</html>
