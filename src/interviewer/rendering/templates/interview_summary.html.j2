<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Post-Interview Summary — {{ summary.candidate_name }} / {{ summary.role }}</title>
  <style>
    body { font-family: Georgia, serif; max-width: 820px; margin: 40px auto; padding: 0 24px; color: #222; line-height: 1.7; }
    h1 { font-size: 1.6rem; margin-bottom: 4px; }
    .meta { color: #666; font-size: 0.9rem; margin-bottom: 32px; }
    h2 { font-size: 1.15rem; border-bottom: 1px solid #ddd; padding-bottom: 4px; margin-top: 36px; }
    ul { margin: 6px 0; padding-left: 20px; }
    li { margin-bottom: 4px; }
    .flag { background: #fdecea; border-left: 4px solid #e74c3c; padding: 10px 16px; font-size: 0.93rem; margin-top: 8px; }
    .section-note { background: #f9f9f9; border-left: 4px solid #ccc; padding: 10px 16px; font-size: 0.93rem; margin-top: 8px; }
  </style>
</head>
<body>

  <h1>Post-Interview Summary</h1>
  <div class="meta">
    Candidate: <strong>{{ summary.candidate_name }}</strong> &nbsp;|&nbsp;
    Role: <strong>{{ summary.role }}</strong> &nbsp;|&nbsp;
    Summarised: {{ today() }}
  </div>

  <h2>Performance Summary</h2>
  <p>{{ summary.performance_summary }}</p>

  <h2>Fit Assessment</h2>
  <p>{{ summary.fit_assessment }}</p>

  <h2>Reservations</h2>
  <div class="flag">
    <ul>
      {% for item in summary.reservations %}
      <li>{{ item }}</li>
      {% endfor %}
    </ul>
  </div>

  <h2>Recommendation</h2>
  <div class="section-note">
    {{ summary.recommendation }}
  </div>

</body>
</html>
